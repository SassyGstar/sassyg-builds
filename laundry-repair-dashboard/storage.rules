rules_version = '2';

/**
 * Job photos, signed work orders and fuel receipts.
 * Photos come off a phone in a basement, so keep the size cap generous enough
 * to be usable and tight enough that nobody uploads a video by accident.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.role; }
    function isStaff()  { return signedIn() && (role() == 'office' || role() == 'owner'); }
    function isImage()  { return request.resource.contentType.matches('image/.*'); }
    function underSize(){ return request.resource.size < 8 * 1024 * 1024; }

    match /workOrders/{workOrderId}/{fileName} {
      allow read:   if signedIn();
      allow create: if signedIn() && isImage() && underSize();
      // A photo of what was found is evidence. It does not get edited later.
      allow update: if false;
      allow delete: if isStaff();
    }

    match /receipts/{vehicleId}/{fileName} {
      allow read:   if signedIn();
      allow create: if signedIn() && isImage() && underSize();
      allow update: if false;
      allow delete: if role() == 'owner';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
